<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon。画布 108dp，系统只显示中间 72dp，外面每边 18dp 留给启动器做视差与缩放，
  所以同一个图标在不同启动器上会被裁成不同的形状（圆、圆角方、水滴……）。

  三个图层由 scripts/export-logo.ps1 按 108dp 五档导出，与桌面 PNG、通知小图标共用同一套
  几何和留白，改几何时一起重跑脚本即可。

  <monochrome> 只被 Android 13+ 的主题图标使用，低版本会忽略这个元素；
  系统取它的 alpha 通道再按壁纸配色上色，所以里面的黑色不是最终显示颜色。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background" />
  <foreground android:drawable="@mipmap/ic_launcher_foreground" />
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
